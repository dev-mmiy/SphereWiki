# SphereWiki runtime configuration — copy to `.env` and fill in.
#
# These are the variables the sync super-peer (`apps/server`) and the client
# builds read. The server does NOT auto-load `.env` (no dotenv dependency):
#   - production: `fly secrets set VAR=value --app <app-name>`
#   - local dev:  `export` the vars in its shell, or `set -a; . ./.env; set +a`
# Client build-time `VITE_*` vars are injected at build/run via the shell too
# (`VITE_SYNC_URL=... pnpm dev`), not by `.env` loading — see docs/M3b-setup.md.

# --- Sync super-peer (apps/server) -------------------------------------------
# Port the WebSocket + HTTP (POST /sync-token) listeners bind to.
PORT=8787

# Per-room durable persistence directory (default ".spherewiki-data").
# On Fly this is the mounted volume mount path.
SPHEREWIKI_DATA_DIR=.spherewiki-data

# Workspace-scoped sync-token signing secret. REQUIRED for a public deployment:
# when set, every room join must present a valid token (transport-level project
# isolation); when UNSET the server runs rooms OPEN (zero-config local/dev).
# Leave unset for local dev; set a strong value before any public deploy:
#   fly secrets set SPHEREWIKI_SYNC_SECRET="$(openssl rand -hex 32)" --app <app>
# Note: a SET-BUT-EMPTY value is a misconfiguration — the server refuses to start
# (it will not silently fall through to open rooms).
SPHEREWIKI_SYNC_SECRET=

# --- Token issuance (P3b): WorkOS AuthKit ------------------------------------
# The WorkOS application client id (a `client_...` string from the WorkOS
# dashboard). When set together with SPHEREWIKI_SYNC_SECRET, POST /sync-token
# verifies the caller's WorkOS AuthKit access token (RS256 against the
# client-id-pinned JWKS + issuer) and mints a workspace-scoped token. Setting
# the client id WITHOUT the sync secret makes token issuance meaningless, so the
# server refuses to start.
WORKOS_CLIENT_ID=

# Interim workspace-membership map (env JSON) until P4's membership store lands.
# Shape: { "<workos org id>": { "<workspace id>": "<role>" } }, role ∈
# admin | editor | viewer. Unset → "{}" (no one is a member, issuance denied).
# Malformed JSON / unknown role fails the server at startup (loud, not silent).
# Example: SPHEREWIKI_ORG_WORKSPACES={"org_1a2b3c":{"ws-dev":"admin","shared-kb":"editor"}}
SPHEREWIKI_ORG_WORKSPACES={}

# --- Client build-time (desktop + web) ---------------------------------------
# The super-peer base URL. Its host also serves POST /sync-token, so one value
# drives both real-time sync and token minting. Unset → local/offline mode.
#   local:  ws://localhost:8787
#   Fly:    wss://<app-name>.fly.dev
VITE_SYNC_URL=
